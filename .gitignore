# ==========================================
# StockPilot - Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Production & Build Outputs
dist/
*/dist/
build/
*/build/
out/
.vite/
.vite-temp/

# Environment Variables & Secrets
.env
.env.*
*.env
**/.env
**/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Preserve example environment template files
!**/.env.example
!.env.example

# Local Database & Storage
.mongo-data/
server/.mongo-data/
*.sqlite
*.sqlite3
*.db

# Local Binaries, Downloads & Scratch Files
ngrok_bin/
scratch/
*.exe
*.bin
*.dll

# Temporary & Uploads
tmp/
temp/
uploads/
*.tmp
*.temp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# IDEs & Code Editors
.vscode/
*/.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# SSL / Certificates / Keys
*.pem
*.key
*.cert
*.crt
