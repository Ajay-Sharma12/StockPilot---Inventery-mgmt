NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/stockpilot

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=stockpilot_dev_access_secret_super_key_3849102847291048
JWT_REFRESH_SECRET=stockpilot_dev_refresh_secret_super_key_8492019482019482
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# Email Configuration (SMTP) - Optional (Defaults to structured console logger in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="StockPilot Operations <procurement@stockpilot.io>"

# SMS Configuration - Optional (Defaults to structured console logger in development)
# SMS_PROVIDER options: 'none' | 'twilio' | 'fast2sms'
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
SMS_FROM_NAME=StockPilot
